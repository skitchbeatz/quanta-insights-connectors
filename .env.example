# MCP Server Configuration
TRANSPORT=stdio
LOG_LEVEL=DEBUG

# Vault Configuration (comment out for mock mode)
# VAULT_ADDR=https://vault.chateaumac.com
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id
# VAULT_NAMESPACE=secret/business/quanta-insights

# Connector Configuration
ENABLED_CONNECTORS=bullhorn,linkedin
BULLHORN_MOCK_MODE=true
LINKEDIN_MOCK_MODE=true

# Rate Limiting
TOOL_CALLS_PER_MINUTE=60
